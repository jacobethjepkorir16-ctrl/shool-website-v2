<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bright Future School</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>
<%- include ("_header.ejs") %>


<section class="hero">

    <div class="hero-content">

        <h2>Welcome to Bright Future School</h2>

        <p>
            Inspiring young minds, building strong character,
            and preparing students for a brighter future.
        </p>

        <a href="/about" class="btn">
            Discover More
        </a>

        <a href="/contact" class="btn secondary">
            Contact Us
        </a>

    </div>

</section>

<section class="intro">

    <h2>Why Choose Our School?</h2>

    <p>
        We provide a friendly learning environment where every
        student gets an opportunity to learn, grow and succeed.
    </p>

    <div class="cards">

        <div class="card">
            <div class="icon">📚</div>

            <h3>Quality Education</h3>

            <p>
                We provide quality education through experienced
                and dedicated teachers.
            </p>
        </div>

        <div class="card">
            <div class="icon">👨‍🏫</div>

            <h3>Qualified Teachers</h3>

            <p>
                Our teachers guide students and help them achieve
                their academic goals.
            </p>
        </div>

        <div class="card">
            <div class="icon">🏆</div>

            <h3>Student Success</h3>

            <p>
                We encourage students to discover their talents
                and become successful.
            </p>
        </div>

    </div>

</section>

<section class="stats">

    <div>
        <h2>500+</h2>
        <p>Students</p>
    </div>

    <div>
        <h2>30+</h2>
        <p>Teachers</p>
    </div>

    <div>
        <h2>15+</h2>
        <p>Subjects</p>
    </div>

    <div>
        <h2>10+</h2>
        <p>Years Experience</p>
    </div>

</section>

<section class="cta">

    <h2>Ready to Join Us?</h2>

    <p>
        Give your child the opportunity to learn, grow
        and achieve their dreams.
    </p>

    <a href="/contact" class="btn">
        Get In Touch
    </a>

</section>

<footer>

    <h3>🎓 Bright Future School</h3>

    <p>
        Quality Education • Discipline • Success
    </p>

    <p>
        &copy; 2026 Bright Future School
    </p>

</footer>

</body>
</html>