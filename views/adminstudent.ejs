<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= student.student_name %> - Student Record</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include("_header.ejs") %>

    <main class="dashboard-page">
        <div class="dashboard-heading">
            <div>
                <p class="eyebrow">Student record</p>
                <h2><%= student.student_name %></h2>
                <p>Student ID: <strong><%= student.student_id %></strong></p>
            </div>
            <a class="dashboard-logout" href="/admin/students">All student records</a>
        </div>

        <section class="dashboard-cards">
            <article class="dashboard-card">
                <span class="card-icon">PROFILE</span>
                <h3>Enrolment details</h3>
                <p><strong>Student ID:</strong> <%= student.student_id %></p>
                <p><strong>Classroom:</strong> <%= student.classroom_name || student.classroom_id || "Not assigned" %></p>
            </article>
            <article class="dashboard-card">
                <span class="card-icon">RESULTS</span>
                <h3>Academic overview</h3>
                <p><strong>Marks recorded:</strong> <%= marks.length %></p>
                <% if (marks.length > 0) { %>
                    <p><strong>Average:</strong> <%= (marks.reduce((total, mark) => total + Number(mark.marks || 0), 0) / marks.length).toFixed(1) %>%</p>
                <% } else { %>
                    <p>No marks have been recorded.</p>
                <% } %>
            </article>
        </section>

        <h3 class="record-heading">Subject marks</h3>
        <table>
            <thead>
                <tr>
                    <th>Mark ID</th>
                    <th>Subject</th>
                    <th>Subject ID</th>
                    <th>Marks</th>
                </tr>
            </thead>
            <tbody>
                <% marks.forEach(mark => { %>
                    <tr>
                        <td><%= mark.mark_id %></td>
                        <td><%= mark.subject_name || "Unknown subject" %></td>
                        <td><%= mark.subject_id %></td>
                        <td><%= mark.marks %></td>
                    </tr>
                <% }); %>
                <% if (marks.length === 0) { %>
                    <tr><td colspan="4">No academic marks are available for this student.</td></tr>
                <% } %>
            </tbody>
        </table>
    </main>

    <footer><p>&copy; 2026 Smart School. All Rights Reserved.</p></footer>
</body>
</html>
