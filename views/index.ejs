<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart School | Home</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- HEADER -->
 <%- include ("_header.ejs") %>


    <!-- HERO SECTION -->
    <section class="hero">

        <div class="hero-content">
            <h2>Welcome to Smart School</h2>

            <p>
                Empowering students with knowledge, skills
                and technology for a brighter future.
            </p>

            <a href="/about" class="hero-button">
                Learn More
            </a>
        </div>

    </section>


    <!-- STATISTICS -->
    <section class="statistics">

        <div class="stat-card">
            <h2>500+</h2>
            <p>Students</p>
        </div>

        <div class="stat-card">
            <h2>30+</h2>
            <p>Teachers</p>
        </div>

        <div class="stat-card">
            <h2>15+</h2>
            <p>Subjects</p>
        </div>

        <div class="stat-card">
            <h2>10+</h2>
            <p>Years of Excellence</p>
        </div>

    </section>


    <!-- FEATURES -->
    <section class="features">

        <h2>Why Choose Smart School?</h2>

        <div class="feature-grid">

            <div class="feature-card">
                <h3>📚 Quality Education</h3>
                <p>
                    We provide quality education that helps
                    students achieve their academic goals.
                </p>
            </div>

            <div class="feature-card">
                <h3>💻 Technology</h3>
                <p>
                    Students learn using modern technology
                    and digital learning resources.
                </p>
            </div>

            <div class="feature-card">
                <h3>🏆 Excellence</h3>
                <p>
                    We encourage students to work hard,
                    develop their talents and achieve excellence.
                </p>
            </div>

        </div>

    </section>


    <!-- CALL TO ACTION -->
    <section class="cta">

        <h2>Ready to Learn?</h2>

        <p>
            Explore our students, subjects and school information.
        </p>

        <a href="/contact" class="hero-button">
            Contact Us
        </a>

    </section>


    <!-- FOOTER -->
    <footer>
        <p>&copy; 2026 Smart School. All Rights Reserved.</p>
    </footer>

</body>
</html>