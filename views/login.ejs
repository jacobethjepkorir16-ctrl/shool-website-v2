<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login - Smart School</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>Smart School</h1>
</header>

<main class="login-page">

    <div class="login-box">

        <h2>School Login</h2>

        <form id="loginForm" action="/login" method="POST">

            <input
                type="text"
                id="identifier"
                name="identifier"
                placeholder="Staff email or student ID"
                required
            >

            <input
                type="password"
                id="password"
                name="password"
                placeholder="Password"
                required
            >

            <button type="submit">Login</button>

        </form>

        <p id="loginMessage"></p>

    </div>

</main>

</body>
</html>